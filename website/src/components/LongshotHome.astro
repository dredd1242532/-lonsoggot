---
import { siteConfig } from '../../site.config.mjs';
import { readFile } from 'node:fs/promises';
import { validateFeed } from '../lib/progress.mjs';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
let feed = null;
try { feed = validateFeed(JSON.parse(await readFile('public/progress-feed.json', 'utf8'))); }
catch { /* Static help remains usable without project activity. */ }
const stable = feed?.stableRelease;
const date = (value) => new Date(value).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const activity = (feed?.items || []).filter(i => i.kind === 'pull' && i.status === 'merged' && i.mergedAt)
  .sort((a, b) => Date.parse(b.mergedAt) - Date.parse(a.mergedAt)).slice(0, 3);
const guides = [
  { n: '01', title: 'Install & play', text: 'Start with your supported copy of the game. Follow the Windows or Linux setup guide.', link: 'guides/getting-started/', label: 'Installation guide', note: 'FIRST ADVENTURE?' },
  { n: '02', title: 'Make it feel right', text: 'Find graphics settings, display options and controller bindings in one place.', link: 'guides/graphics-and-controls/', label: 'Graphics & controls', note: 'YOUR SETUP, YOUR WAY' },
  { n: '03', title: 'Protect your progress', text: 'Find your saves, make a backup and check the steps before updating.', link: 'guides/updates-and-saves/', label: 'Updates & saves', note: 'SAVE THE ADVENTURE' },
];
---
<div class="studio-home not-content">
  <aside class="studio-release-bar" aria-label="Source release information">
    <div><span class="studio-tag">SOURCE RELEASE</span><strong>Hookshot {stable?.tag || 'releases'}</strong><span class="studio-release-date">{stable ? date(stable.publishedAt) : 'Visit the release page'}</span></div>
    <a href={stable?.url || 'https://github.com/NotRexed/Hookshot/releases/latest'}>Release notes & downloads <span aria-hidden="true">↗</span></a>
  </aside>
  <section id="guides" class="studio-section">
    <div class="studio-section-heading"><div><p class="studio-eyebrow">01 / THE ESSENTIALS</p><h2>Less wandering.<br />More adventure.</h2></div><a class="studio-text-link" href={`${base}reference/manual/`}>Full documentation <span aria-hidden="true">↗</span></a></div>
    <div class="studio-guides">{guides.map(g => <article><span class="studio-card-number" aria-hidden="true">{g.n}</span><p class="studio-eyebrow">{g.note}</p><h3>{g.title}</h3><p>{g.text}</p><a href={`${base}${g.link}`}>{g.label}<span aria-hidden="true">↗</span></a></article>)}</div>
    <div class="studio-compatibility"><span>Not sure your setup is ready?</span><a href={`${base}compatibility/`}>Check compatibility <span aria-hidden="true">→</span></a></div>
  </section>
  <section id="development" class="studio-section studio-development">
    <div class="studio-development-intro">
      <p class="studio-eyebrow">02 / DEVELOPMENT</p><h2>Long reach.<br />Small details.</h2>
      <p>Follow the work behind the adventure. Changes, discussions and the evidence that goes with them.</p>
      <a class="studio-text-link" href={siteConfig.projectRepository}>Explore Longshot on magicbean <span aria-hidden="true">↗</span></a>
      <figure class="studio-development-icon"><img src={`${base}branding/longshot.png`} width="512" height="512" alt="The Longshot grappling hook." loading="lazy" /><figcaption>LONGSHOT / TEAM MAGICBEAN</figcaption></figure>
    </div>
    <div class="studio-development-feed">
      <div class="studio-feed-heading"><h3>Upstream activity</h3><span class="studio-tag">HOOKSHOT ACTIVITY</span></div>
      <p class="studio-feed-note">Merged in Hookshot. Release availability is not implied.</p>
      <ol class="studio-activity">{activity.map(item => <li><div><span class="studio-merge-state">Merged</span><time datetime={item.mergedAt}>{date(item.mergedAt)}</time><span>#{item.number}</span></div><h4><a href={item.url}>{item.title} <span aria-hidden="true">↗</span></a></h4></li>)}</ol>
      {!activity.length && <p>Activity is unavailable. <a href="https://github.com/NotRexed/Hookshot/pulls">Browse proposed changes on GitHub</a>.</p>}
      <p class="studio-snapshot">{feed ? `Snapshot collected ${new Date(feed.generatedAt).toISOString().replace('T', ' ').slice(0, 16)} UTC.` : 'No activity snapshot available.'} <a href="https://github.com/NotRexed/Hookshot">View Hookshot source ↗</a></p>
    </div>
  </section>
  <section id="help" class="studio-section studio-help">
    <div class="studio-help-copy"><p class="studio-eyebrow">03 / PLAYER SUPPORT</p><h2>It’s okay.<br />The bean cried too.</h2><p>Check to see if other people have the same bug as you. No heroic guesswork required.</p><div class="studio-support-bean" aria-hidden="true"><img src={`${base}branding/magicbean-green.png`} alt="" width="1024" height="1024" loading="lazy" /></div></div>
    <div class="studio-help-tools">
      <form data-frontpage-search role="search" aria-label="Find a reported problem" action={`${base}progress/#problem-search`}><label for="frontpage-query">What’s going wrong?</label><div class="studio-search-row"><input id="frontpage-query" type="search" placeholder="Black screen, controller, stutter…" maxlength="300" aria-describedby="studio-search-note" /><button type="submit">Find help <span aria-hidden="true">→</span></button></div></form>
      <div class="studio-topics"><span>Try:</span>{['Black screen', 'Controller', 'Stutter'].map(q => <a href={`${base}progress/#problem-search?q=${encodeURIComponent(q)}`}>{q}</a>)}</div>
      <p id="studio-search-note">Searches the Hookshot report snapshot. Reports are not confirmed diagnoses.</p>
      <a class="studio-help-guide" href={`${base}guides/common-issues/`}><span><strong>Common issues</strong><small>Start with the troubleshooting guide</small></span><span aria-hidden="true">↗</span></a>
      <noscript><p>Enable JavaScript to carry your search to the report board, or use the guide above.</p></noscript>
    </div>
  </section>
  <section class="studio-team" aria-labelledby="team-title"><img class="studio-team-logo" src={`${base}branding/magicbean-team-logo.webp`} alt="" width="512" height="512" loading="lazy" /><div><p class="studio-eyebrow">THE PEOPLE BEHIND THE BEANS</p><h2 id="team-title">Made by team magicbean.</h2><p>Serious about the details. Less serious about ourselves.</p></div><a class="studio-text-link" href={`${base}about/`}>Meet Longshot <span aria-hidden="true">↗</span></a></section>
</div>
<script>
  import { problemSearchHash } from '../lib/problem-search.mjs';
  const form = document.querySelector<HTMLFormElement>('[data-frontpage-search]');
  form?.addEventListener('submit', event => {
    event.preventDefault();
    const url = new URL(form.action);
    url.hash = problemSearchHash(document.querySelector<HTMLInputElement>('#frontpage-query')!.value);
    location.assign(url.href);
  });
</script>
