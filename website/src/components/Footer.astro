---
import { siteConfig } from '../../site.config.mjs';
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<DefaultFooter />
<div class="field-footer">
  <p class="studio-footer-credit"><img src={`${base}branding/magicbean-team-logo.webp`} alt="" width="512" height="512" loading="lazy" /><span><strong>LONGSHOT</strong> by <a href="https://magicbean.dev/">team magicbean</a></span></p>
  <nav aria-label="Footer"><a href={`${base}team/`}>Team roster</a><a href={`${base}about/`}>About Longshot</a><a href={siteConfig.issueUrl}>Longshot issue tracker ↗</a><a href={siteConfig.projectRepository}>Longshot repository ↗</a></nav>
  <p>We do not host, store, or distribute any game files, ROMs, game dumps, or decryption keys. You must provide your own copy.</p>
  <small>Independent community project. Not affiliated with Nintendo. Built with Astro Starlight.</small>
</div>
