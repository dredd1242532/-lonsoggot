#version 450
// Longshot's NR input is perceptually encoded SDR (sqrt of the game's linear scene).
// Change chromaticity at the NR luminance, then encode back for the existing DLSS path.
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D original;
layout(binding=1) uniform sampler2D neural;
layout(binding=2) uniform sampler2D depth;
layout(binding=3) uniform sampler2D motion;
layout(binding=4, rgba16f) uniform writeonly image2D result;
layout(binding=5) uniform sampler2D hdr_original;
layout(push_constant) uniform P { ivec2 size; ivec2 input_size; float color; int debug_view; int hdr; } pc;
const vec3 Y = vec3(0.2126, 0.7152, 0.0722);
vec4 sample_low(sampler2D tex,vec2 uv){
 vec2 q=uv*vec2(pc.input_size)-0.5;ivec2 b=ivec2(floor(q));vec2 t=fract(q);
 ivec2 hi=pc.input_size-1;
 return mix(mix(texelFetch(tex,clamp(b,ivec2(0),hi),0),texelFetch(tex,clamp(b+ivec2(1,0),ivec2(0),hi),0),t.x),mix(texelFetch(tex,clamp(b+ivec2(0,1),ivec2(0),hi),0),texelFetch(tex,clamp(b+ivec2(1,1),ivec2(0),hi),0),t.x),t.y);
}
void main() {
    ivec2 dst = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(dst, pc.size))) return;
    ivec2 p = min(ivec2((vec2(dst) + 0.5) * vec2(pc.input_size) / vec2(pc.size)), pc.input_size - 1);
    vec2 uv=(vec2(dst)+0.5)/vec2(pc.size);
    vec4 a=all(equal(pc.size,pc.input_size)) ? texelFetch(original,dst,0) : sample_low(original,uv);
    vec4 b=all(equal(pc.size,pc.input_size)) ? texelFetch(neural,dst,0) : sample_low(neural,uv);
    vec3 al = max(a.rgb, vec3(0)); al *= al;
    vec3 bl = max(b.rgb, vec3(0)); bl *= bl;
    vec3 c;
    if (pc.debug_view == 1) { imageStore(result, dst, pc.hdr != 0 ? texelFetch(hdr_original,dst,0) : a); return; }
    if (pc.debug_view == 2) { imageStore(result, dst, b); return; }
    if (pc.debug_view == 3) {
        float d = clamp(dot(abs(bl-al), Y) * 20.0, 0.0, 1.0);
        c = clamp(vec3(3*d, 3*d-1, 3*d-2), 0.0, 1.0);
    } else if (pc.debug_view == 4) {
        c = vec3(clamp(texelFetch(depth, p, 0).r, 0.0, 1.0));
    } else if (pc.debug_view == 5) {
        vec2 mv = texelFetch(motion, p, 0).xy;
        c = vec3(clamp(vec2(0.5) + mv/32.0, 0.0, 1.0), 0.5);
    } else {
        float ya = dot(al, Y), yb = dot(bl, Y);
        vec3 kept = ya > 1e-6 ? al * (yb/ya) : vec3(yb);
        c = mix(kept, bl, pc.color);
        // Compress chroma toward neutral at constant luminance, rather than clipping channels.
        if (yb >= 0 && yb <= 1) {
            vec3 chroma = c - vec3(yb);
            float k = 1.0;
            for (int i=0; i<3; ++i) {
                if (chroma[i] > 0) k = min(k, (1-yb)/chroma[i]);
                if (chroma[i] < 0) k = min(k, -yb/chroma[i]);
            }
            c = vec3(yb) + max(k, 0) * chroma;
        }
    }
    if (pc.hdr != 0 && pc.debug_view == 0) {
        vec4 source = texelFetch(hdr_original,dst,0);
        vec3 h = max(source.rgb,vec3(0));
        if(pc.hdr==2)h*=h;
        float scale = pc.hdr==1 ? 1.0 + max(h.r,max(h.g,h.b)) : 1.0;
        // Identity NR output is an exact no-op before half-float rounding.
        // Model edits are residuals; highlights never pass through an SDR clamp.
        vec3 light=clamp(h+(c-al)*scale,vec3(0),vec3(pc.hdr==1 ? 65504.0 : 1.0));
        imageStore(result,dst,vec4(pc.hdr==2 ? sqrt(light) : light,source.a));
    } else imageStore(result, dst, vec4(sqrt(max(c, vec3(0))), a.a));
}
