{
  "name": "Longshot CI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/jdx/devcontainer-features/mise:1": {}
  },
  "postCreateCommand": "mise trust -a && mise install",
